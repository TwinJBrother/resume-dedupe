<Project Sdk="Microsoft.NET.Sdk">

  <!-- Jellyfin 12.x: .NET 10, ABI 12.0.0.0 (carrega em 12.0 e superiores) -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.ResumeDedupe</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.ResumeDedupe</RootNamespace>
    <Version>3.0.3.0</Version>
    <AssemblyVersion>3.0.3.0</AssemblyVersion>
    <FileVersion>3.0.3.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- A 3.0 nao tem tela de configuracao: ignora sobras da 2.x se ficarem no repositorio. -->
  <ItemGroup>
    <Compile Remove="Configuration/**" />
  </ItemGroup>

</Project>
